        text status
        int revision
        text created_at
        text updated_at
    }
    TASK_DEPENDENCY {
        text task_id PK,FK
        text prerequisite_id PK,FK
    }
    ATTEMPT {
        text id PK
        text task_id FK
        int ordinal
        text executor_id
        text provider_model_json
        text provider_session
        text process_status
        text started_at
        text finished_at
        text created_at
    }
    WORKSPACE {
        text id PK
        text attempt_id FK,UK
        text canonical_path UK
        text base_sha
        text branch
        text status
    }
    RESULT {
        text id PK
        text attempt_id FK,UK
        int exit_code
        boolean simulated
        text outcome
        text summary
        text patch_artifact_id FK
        text created_at
    }
